# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Conexión MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=upea_security_db

# Sincronización automática de TypeORM (true solo en desarrollo local, false en producción)
DB_SYNCHRONIZE=true

# Logs de consultas SQL en terminal (true / false)
DB_LOGGING=true
